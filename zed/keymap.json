// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    }
  },
  // =============================
  // ====== VSCODE TEXT KEYS =====
  // =============================
  {
    "context": "Editor && mode == full",
    "bindings": {
      // alt+; -> cursorEnd + type ";"
      "alt-;": ["workspace::SendKeystrokes", "end ;"],
      // ctrl+enter -> insert line after (editor.action.insertLineAfter)
      "ctrl-enter": "editor::NewlineBelow",
      // ctrl+0 -> zoom reset (workbench.action.zoomReset)
      "ctrl-0": ["zed::ResetBufferFontSize", { "persist": false }]
    }
  },
  // =============================================================
  // ====== VIM HANDLEKEYS (a,b,f,j,k,p,s,w NOT hijacked) ========
  // ====== Restore native VSCode ctrl shortcuts from vim ========
  // =============================================================
  {
    "context": "VimControl && !menu",
    "bindings": {
      // <C-a> native: select all
      "ctrl-a": "editor::SelectAll",
      // <C-b> native: toggle sidebar
      "ctrl-b": "workspace::ToggleLeftDock",
      // <C-f> native: find in file
      "ctrl-f": "buffer_search::Deploy",
      // <C-j> native: toggle terminal panel
      "ctrl-j": "terminal_panel::Toggle",
      // <C-k> left to Zed (chord leader, biarkan Zed menangani)
      // <C-p> native: quick open
      "ctrl-p": "file_finder::Toggle",
      // <C-s> native: save
      "ctrl-s": "workspace::Save",
      // <C-w> native: close editor
      "ctrl-w": "pane::CloseActiveItem"
    }
  },
  // ==========================
  // ====== VIM LEADER KEY ====
  // ==========================
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      // space w -> [W]rite (save + format via format_on_save)
      "space w": "workspace::Save",
      // space f f -> [F]ind [F]iles
      "space f f": "file_finder::Toggle",
      // space e -> [E]xplorer (toggle sidebar)
      "space e": "workspace::ToggleLeftDock"
    }
  },
  // ==================================
  // ====== TAB INDENT/OUTDENT ========
  // ==================================
  {
    "context": "Editor",
    "bindings": {
      "tab": "editor::Tab",
      "shift-tab": "editor::Backtab"
    }
  },
  // =====================================================
  // ====== alt+j / alt+k = arrow-like navigation =======
  // Pickers, lists and menus (behaves exactly like up/down)
  {
    "context": "menu || Picker",
    "bindings": {
      "alt-j": "menu::SelectNext",
      "alt-k": "menu::SelectPrevious"
    }
  },
  // Completion / suggestion menu (moves selection, stays open)
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "alt-j": "editor::ContextMenuNext",
      "alt-k": "editor::ContextMenuPrevious"
    }
  }
]
