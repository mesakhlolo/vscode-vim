// Place your key bindings in this file to override the defaults
[
  // ====== KEYBINDINGS VSCode (custom) ======
  // semicolon at the end
  {
    "key": "alt+;",
    "command": "runCommands",
    "args": {
      "commands": [
        "cursorEnd",
        {
          "command": "type",
          "args": {
            "text": ";"
          }
        }
      ]
    },
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "alt+i",
    "command": "editor.emmet.action.balanceIn"
  },
  {
    "key": "alt+o",
    "command": "editor.emmet.action.balanceOut"
  },
  {
    "key": "alt+a",
    "command": "editor.emmet.action.wrapWithAbbreviation"
  },
  {
    "key": "shift+alt+g",
    "command": "github.copilot.generate",
    "when": "editorTextFocus && github.copilot.activated && !commentEditorFocused && !inInteractiveInput && !interactiveEditorFocused"
  },
  {
    "key": "ctrl+enter",
    "command": "-github.copilot.generate",
    "when": "editorTextFocus && github.copilot.activated && !commentEditorFocused && !inInteractiveInput && !interactiveEditorFocused"
  },
  {
    "key": "ctrl+enter",
    "command": "editor.action.insertLineAfter",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+enter",
    "command": "-editor.action.insertLineAfter",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+alt+enter",
    "command": "github.copilot.generate",
    "when": "editorTextFocus && github.copilot.activated && !commentEditorFocused"
  },
  {
    "key": "ctrl+enter",
    "command": "-github.copilot.generate",
    "when": "editorTextFocus && github.copilot.activated && !commentEditorFocused"
  },
  {
    "key": "ctrl+0",
    "command": "workbench.action.zoomReset"
  },
  {
    "key": "ctrl+numpad0",
    "command": "-workbench.action.zoomReset"
  },

  // VIM LEADER KEY (space)
  {
    "key": "space w", // [W]rite (Save + format)
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.files.save",
        "editor.action.formatDocument"
      ]
    },
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  {
    "key": "space f f", // [F]ind [F]iles
    "command": "workbench.action.quickOpen",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space e", // [E]xplorer (toggle sidebar)
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  // Ensure Tab key indents text properly in editor
  {
    "key": "tab",
    "command": "tab",
    "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode"
  },
  // Ensure Shift+Tab key outdents text properly in editor
  {
    "key": "shift+tab",
    "command": "outdent",
    "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode"
  },
  // General List Navigation (Sidebar Explorer, Search Results Panel, Dropdown Lists)
  {
    "key": "alt+j",
    "command": "list.focusDown",
    "when": "listFocus"
  },
  {
    "key": "alt+k",
    "command": "list.focusUp",
    "when": "listFocus"
  },
  // Quick Open Navigation (Ctrl+P & Ctrl+Shift+P) - Behaves exactly like arrow keys
  {
    "key": "alt+j",
    "command": "workbench.action.quickOpenSelectNext",
    "when": "inQuickOpen"
  },
  {
    "key": "alt+k",
    "command": "workbench.action.quickOpenSelectPrevious",
    "when": "inQuickOpen"
  },
  // Auto-complete Suggestion Navigation (IntelliSense Widget)
  {
    "key": "alt+j",
    "command": "selectNextSuggestion",
    "when": "suggestWidgetVisible"
  },
  {
    "key": "alt+k",
    "command": "selectPrevSuggestion",
    "when": "suggestWidgetVisible"
  }
]
