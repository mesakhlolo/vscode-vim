// Place your key bindings in this file to override the defaults
// ============================================================
// ============ VSCode + VSCodeVim — LazyVim CORE ==============
// ============================================================
// Semua binding ditulis literal sebagai chord di file ini
// (pola leviFrosty). Leader = <space> murni chord VS Code.
// settings.json hanya menampung opsi vim.*
// ============================================================
[
  // =============================
  // ======= FILE & WINDOW =======
  // =============================
  {
    "key": "space f f", // [F]ind [F]iles
    "command": "workbench.action.quickOpen",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)",
  },
  {
    "key": "space s g", // [S]earch [G]rep
    "command": "workbench.action.findInFiles",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)",
  },
  {
    "key": "space w", // [W]rite (Save + format)
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.files.save",
        "editor.action.formatDocument"
      ]
    },
    "when": "vim.mode == 'Normal' && editorTextFocus",
  },
  {
    "key": "space e", // [E]xplorer (toggle sidebar)
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)",
  },

  // =============================
  // ======= BUFFER (TAB) ========
  // =============================
  {
    "key": "] b", // [N]ext [B]uffer
    "command": "workbench.action.nextEditorInGroup",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)",
  },
  {
    "key": "[ b", // [P]rev [B]uffer
    "command": "workbench.action.previousEditorInGroup",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)",
  },
  {
    "key": "space b d", // [B]uffer [D]elete
    "command": "workbench.action.closeActiveEditor",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)",
  },
  {
    "key": "space b o", // [B]uffer Delete [O]thers (tutup semua tab lain)
    "command": "workbench.action.closeOtherEditors",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)",
  },

  // ============================
  // ====== CODE & LSP ==========
  // ============================
  {
    "key": "g d", // [G]o to [D]efinition
    "command": "editor.action.revealDefinition",
    "when": "vim.mode == 'Normal' && editorTextFocus",
  },
]